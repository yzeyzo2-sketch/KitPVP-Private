-- ============================================================
-- SILENT AURA
-- ============================================================
local function runSilentAura()
    if not Config.SilentAura.Enabled then return end
    local root = getRoot(LocalPlayer)
    if not root then return end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if Config.SilentAura.TeamCheck and isTeammate(p) then continue end
        if not isAlive(p) then continue end
        local er = getRoot(p)
        if not er then continue end
        if (root.Position - er.Position).Magnitude <= Config.SilentAura.Radius then
            if math.random(1,100) <= Config.SilentAura.HitChance then
                pcall(function()
                    local re = tool:FindFirstChildOfClass("RemoteEvent")
                    if re then re:FireServer(er) end
                end)
            end
        end
    end
end

