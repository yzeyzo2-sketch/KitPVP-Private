-- ============================================================
-- UTILITY
-- ============================================================
local function getChar(p) return p.Character end
local function getRoot(p) local c=getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p)  local c=getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(p) local h=getHum(p) return h and h.Health > 0 end
local function isTeammate(p) return p.Team == LocalPlayer.Team end

local function toScreen(pos)
    local s, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), on, s.Z
end

local function getClosest(fov)
    local best, bestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if Config.AimAssist.TeamCheck and isTeammate(p) then continue end
        if not isAlive(p) then continue end
        local part = p.Character and p.Character:FindFirstChild(Config.AimAssist.TargetPart)
        if not part then continue end
        local sp, on = toScreen(part.Position)
        if not on then continue end
        local d = (center - sp).Magnitude
        if d < bestDist then bestDist = d best = p end
    end
    return best
end

-- ============================================================
-- ESP
-- ============================================================
local ESPObjects = {}

local function newDraw(type, props)
    local o = Drawing.new(type)
    for k,v in pairs(props) do o[k]=v end
    return o
end

local function createESP(player)
    ESPObjects[player] = {
        Box      = newDraw("Square", {Visible=false,Thickness=1,Color=Config.ESP.BoxColor,Filled=false}),
        Name     = newDraw("Text",   {Visible=false,Size=13,Color=Config.ESP.TextColor,Center=true,Outline=true,OutlineColor=Color3.fromRGB(0,0,0)}),
        Health   = newDraw("Text",   {Visible=false,Size=12,Color=Color3.fromRGB(100,255,100),Center=true,Outline=true,OutlineColor=Color3.fromRGB(0,0,0)}),
        Distance = newDraw("Text",   {Visible=false,Size=11,Color=Config.ESP.TextColor,Center=true,Outline=true,OutlineColor=Color3.fromRGB(0,0,0)}),
        Tracer   = newDraw("Line",   {Visible=false,Thickness=Config.Tracers.Thickness,Color=Config.ESP.TracerColor}),
    }
end

local function removeESP(player)
    if ESPObjects[player] then
        for _,o in pairs(ESPObjects[player]) do o:Remove() end
        ESPObjects[player] = nil
    end
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local esp = ESPObjects[player]
        if not esp then continue end

        local char = getChar(player)
        local root = getRoot(player)
        local hum  = getHum(player)

        if not char or not root or not hum or hum.Health <= 0
        or (Config.ESP.TeamCheck and isTeammate(player)) then
            for _,o in pairs(esp) do o.Visible = false end
            continue
        end

        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if dist > Config.ESP.MaxDistance then
            for _,o in pairs(esp) do o.Visible = false end
            continue
        end

        local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
        local hits = 0

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local corners = {
                    part.CFrame * CFrame.new( part.Size.X/2,  part.Size.Y/2,  part.Size.Z/2),
                    part.CFrame * CFrame.new(-part.Size.X/2,  part.Size.Y/2, -part.Size.Z/2),
                    part.CFrame * CFrame.new( part.Size.X/2, -part.Size.Y/2,  part.Size.Z/2),
                    part.CFrame * CFrame.new(-part.Size.X/2, -part.Size.Y/2, -part.Size.Z/2),
                }
                for _, c in ipairs(corners) do
                    local sp, on = toScreen(c.Position)
                    if on then
                        hits = hits + 1
                        minX=math.min(minX,sp.X) minY=math.min(minY,sp.Y)
                        maxX=math.max(maxX,sp.X) maxY=math.max(maxY,sp.Y)
                    end
                end
            end
        end

        if hits == 0 then
            for _,o in pairs(esp) do o.Visible = false end
            continue
        end

        local bW = maxX - minX
        local bH = maxY - minY

        esp.Box.Visible      = Config.ESP.Boxes
        esp.Box.Position     = Vector2.new(minX, minY)
        esp.Box.Size         = Vector2.new(bW, bH)

        esp.Name.Visible     = Config.ESP.Names
        esp.Name.Position    = Vector2.new(minX + bW/2, minY - 16)
        esp.Name.Text        = player.Name

        esp.Health.Visible   = Config.ESP.Health
        esp.Health.Position  = Vector2.new(minX + bW/2, minY + bH + 2)
        esp.Health.Text      = math.floor(hum.Health).."/"..math.floor(hum.MaxHealth).." HP"

        esp.Distance.Visible = Config.ESP.Distance
        esp.Distance.Position= Vector2.new(minX + bW/2, minY + bH + 14)
        esp.Distance.Text    = math.floor(dist).." studs"

        if Config.Tracers.Enabled then
            local origin = Config.ESP.TracerOrigin == "Bottom"
                and Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                or  Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            local tp, on = toScreen(root.Position)
            esp.Tracer.Visible = on
            esp.Tracer.From    = origin
            esp.Tracer.To      = tp
        else
            esp.Tracer.Visible = false
        end
    end
end

-- ============================================================
-- AIM ASSIST
-- ============================================================
local touchActive = false

local function runAimAssist()
    if not Config.AimAssist.Enabled then return end

    local fire = false
    if IsMobile then
        fire = Config.MobileAim.AutoAimOnTouch and touchActive
    else
        fire = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            or UserInputService:IsKeyDown(Enum.KeyCode.Q)
    end
    if not fire then return end

    local target = getClosest(Config.AimAssist.FOV)
    if not target then return end
    local part = target.Character and target.Character:FindFirstChild(Config.AimAssist.TargetPart)
    if not part then return end
    local sp, on = toScreen(part.Position)
    if not on then return end

    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local delta  = sp - center
    mousemoverel(
        delta.X * (1 - Config.AimAssist.Smoothness),
        delta.Y * (1 - Config.AimAssist.Smoothness)
    )
end

