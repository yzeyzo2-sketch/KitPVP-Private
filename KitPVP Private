    R = newDraw("Line",{Visible=false,Thickness=1,Color=Config.Visuals.CrosshairColor}),
    U = newDraw("Line",{Visible=false,Thickness=1,Color=Config.Visuals.CrosshairColor}),
    D = newDraw("Line",{Visible=false,Thickness=1,Color=Config.Visuals.CrosshairColor}),
}
local FOVC = newDraw("Circle",{Visible=false,Thickness=1,Color=Config.Visuals.FOVColor,Filled=false,NumSides=64})

local function updateVisuals()
    local c  = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local s  = Config.Visuals.CrosshairSize
    local on = Config.Visuals.CrosshairEnabled
    CH.L.From=c-Vector2.new(s,0) CH.L.To=c-Vector2.new(3,0) CH.L.Visible=on
    CH.R.From=c+Vector2.new(3,0) CH.R.To=c+Vector2.new(s,0) CH.R.Visible=on
    CH.U.From=c-Vector2.new(0,s) CH.U.To=c-Vector2.new(0,3) CH.U.Visible=on
    CH.D.From=c+Vector2.new(0,3) CH.D.To=c+Vector2.new(0,s) CH.D.Visible=on
    FOVC.Position = c
    FOVC.Radius   = Config.AimAssist.FOV
    FOVC.Visible  = Config.Visuals.FOVCircle and Config.AimAssist.Enabled
end

