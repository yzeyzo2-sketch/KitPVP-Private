local function addToggle(label, cfg, key)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1,-8,0,ROW_H)
    Row.BackgroundColor3 = Color3.fromRGB(22,22,22)
    Row.BorderSizePixel = 0
    Row.Parent = Scroll
    Instance.new("UICorner",Row).CornerRadius = UDim.new(0,5)

    local L = Instance.new("TextLabel")
    L.Size = UDim2.new(0.65,0,1,0)
    L.Position = UDim2.new(0,10,0,0)
    L.BackgroundTransparency = 1
    L.Text = label
    L.TextColor3 = Color3.fromRGB(210,210,210)
    L.Font = Enum.Font.Gotham
    L.TextSize = FSIZE_L
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Parent = Row

    local BtnW = math.floor(52*SCALE)
    local BtnH = math.floor(26*SCALE)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0,BtnW,0,BtnH)
    Btn.Position = UDim2.new(1,-(BtnW+8),0.5,-BtnH/2)
    Btn.BackgroundColor3 = cfg[key] and Color3.fromRGB(255,255,255) or Color3.fromRGB(45,45,45)
    Btn.Text = cfg[key] and "ON" or "OFF"
    Btn.TextColor3 = cfg[key] and Color3.fromRGB(0,0,0) or Color3.fromRGB(180,180,180)
    Btn.Font = Enum.Font.GothamBold
    Btn.TextSize = FSIZE_S
    Btn.BorderSizePixel = 0
    Btn.Parent = Row
    Instance.new("UICorner",Btn).CornerRadius = UDim.new(0,5)

    local function refresh()
        Btn.BackgroundColor3 = cfg[key] and Color3.fromRGB(255,255,255) or Color3.fromRGB(45,45,45)
        Btn.Text = cfg[key] and "ON" or "OFF"
        Btn.TextColor3 = cfg[key] and Color3.fromRGB(0,0,0) or Color3.fromRGB(180,180,180)
    end

    Btn.MouseButton1Click:Connect(function()
        cfg[key] = not cfg[key]
        refresh()
    end)
end

local function addSlider(label, cfg, key, mn, mx)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1,-8,0,math.floor(50*SCALE))
    Row.BackgroundColor3 = Color3.fromRGB(22,22,22)
    Row.BorderSizePixel = 0
    Row.Parent = Scroll
    Instance.new("UICorner",Row).CornerRadius = UDim.new(0,5)

    local L = Instance.new("TextLabel")
    L.Size = UDim2.new(1,-10,0,math.floor(18*SCALE))
    L.Position = UDim2.new(0,10,0,4)
    L.BackgroundTransparency = 1
    L.Text = label..": "..cfg[key]
    L.TextColor3 = Color3.fromRGB(200,200,200)
    L.Font = Enum.Font.Gotham
    L.TextSize = FSIZE_S
    L.TextXAlignment = Enum.TextXAlignment.Left
    L.Parent = Row

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1,-20,0,math.floor(8*SCALE))
    Track.Position = UDim2.new(0,10,1,-math.floor(14*SCALE))
    Track.BackgroundColor3 = Color3.fromRGB(50,50,50)
    Track.BorderSizePixel = 0
    Track.Parent = Row
    Instance.new("UICorner",Track).CornerRadius = UDim.new(0,4)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((cfg[key]-mn)/(mx-mn),0,1,0)
    Fill.BackgroundColor3 = Color3.fromRGB(255,255,255)
    Fill.BorderSizePixel = 0
    Fill.Parent = Track
    Instance.new("UICorner",Fill).CornerRadius = UDim.new(0,4)

    local dragging = false

    local function applyDrag(inputPos)
        local ts = Track.AbsolutePosition.X
        local te = ts + Track.AbsoluteSize.X
        local t  = math.clamp((inputPos - ts)/(te - ts), 0, 1)
        local v  = math.floor(mn + t*(mx-mn))
        cfg[key] = v
        Fill.Size = UDim2.new(t,0,1,0)
        L.Text = label..": "..v
    end

    -- PC
    Track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging then applyDrag(UserInputService:GetMouseLocation().X) end
    end)

    -- Mobile
    Track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            applyDrag(i.Position.X)
        end
    end)
    Track.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.Touch then
            applyDrag(i.Position.X)
        end
    end)
    Track.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then dragging=false end
    end)
end

